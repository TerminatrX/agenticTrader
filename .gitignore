__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime state — never commit live trading data
data/*.db
data/*.sqlite3
data/*.jsonl
!data/.gitkeep

# The halt flag is machine-local operational state
HALT

# Account identity and any other machine-local config. Account numbers are
# identifying information and are permanent once committed, so they never
# enter the repo. Track `*.example.yaml` templates instead.
*.local.yaml
*.local.yml
config/account.yaml
.env
.env.*
!.env.example

# Machine-local Claude Code settings (personal permission grants, overrides).
# `.claude/settings.json` IS tracked — it carries the risk-config guard hook,
# and that protection should travel with the repo.
.claude/settings.local.json

# Captured MCP payloads may embed account identifiers and position data.
*.bundle.json
bundles/
scratch/
