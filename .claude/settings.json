{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard_risk_config.py\" 2>/dev/null || exit 0",
            "statusMessage": "Checking risk-config guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard_risk_config.py\" 2>/dev/null || exit 0",
            "statusMessage": "Checking risk-config guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
